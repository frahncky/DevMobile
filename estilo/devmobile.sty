\definecolor{vermelhoerro}{HTML}{A33B20}

% ------------------------------------------------------- metadados do curso --
\newcommand{\nomecurso}{Desenvolvimento Mobile}
\newcommand{\autorcurso}{Prof. Dr. Francisco dos Santos Viana}
\newcommand{\localcurso}{São Luís -- Maranhão -- Brasil}
\newcommand{\anocurso}{\the\year}
\newcommand{\nummodulo}{00}
\newcommand{\nivelmodulo}{Iniciante}

\newcommand{\trilhamodulo}{}
\newcommand{\rotulotrilha}{COMUM ÀS TRILHAS}

% \modulo[trilha]{número}{título}{subtítulo}
%   trilha: Kotlin, Flutter ou vazio (módulo comum às duas trilhas)
%   nível pelo número: 00--07 Iniciante, 08--15 Intermediário, 16--20 Avançado
\newcommand{\modulo}[4][]{%
  \renewcommand{\nummodulo}{#2}%
  \def\trilhamodulo{#1}%
  \ifx\trilhamodulo\@empty
    \renewcommand{\rotulotrilha}{COMUM ÀS TRILHAS}%
    \title[Módulo #2 · #3]{#3}%
  \else
    \renewcommand{\rotulotrilha}{TRILHA \MakeUppercase{#1}}%
    \title[#1 · Módulo #2 · #3]{#3}%
  \fi
  \ifnum#2<8\relax\renewcommand{\nivelmodulo}{Iniciante}%
  \else\ifnum#2<16\relax\renewcommand{\nivelmodulo}{Intermediário}%
  \else\renewcommand{\nivelmodulo}{Avançado}\fi\fi
  \subtitle{#4}%
  \author{\autorcurso}%
  \date{\localcurso\quad$\cdot$\quad\anocurso}%
}

% marcadores do modelo da casa
\newcommand{\pd}[1]{\textcolor{ambar}{\textbf{[#1]}}}          % dado a confirmar
\newcommand{\dest}[1]{\textcolor{azulpetroleo}{\textbf{#1}}}    % destaque no texto

% ---------------------------------------------------------- estilo Beamer ----
\usetheme{default}
\setbeamertemplate{navigation symbols}{}
\setbeamersize{text margin left=6mm,text margin right=6mm}
\setbeamercolor{normal text}{fg=cinzatexto}
\setbeamercolor{structure}{fg=azulpetroleo}
\setbeamercolor{alerted text}{fg=ambar}
\setbeamercolor{example text}{fg=verdeok}
\setbeamercolor{itemize/enumerate body}{fg=cinzatexto}
\setbeamerfont{frametitle}{series=\bfseries,size=\large}
\setbeamerfont{title}{series=\bfseries,size=\LARGE}

% marcadores: quadrado âmbar e travessão azul
\setbeamertemplate{itemize item}{\textcolor{ambar}{\rule[0.35ex]{0.5em}{0.5em}}}
\setbeamertemplate{itemize subitem}{\textcolor{azulpetroleo}{--}}
\setbeamertemplate{itemize subsubitem}{\textcolor{cinzamedio}{\tiny$\circ$}}
\setbeamertemplate{enumerate item}{\textcolor{azulpetroleo}{\bfseries\insertenumlabel.}}
\setbeamertemplate{enumerate subitem}{\textcolor{ambar!85!black}{\insertsubenumlabel)}}

% sumário
\setbeamertemplate{section in toc}{%
  \leavevmode\textcolor{ambar}{\rule[0.35ex]{0.5em}{0.5em}}\enspace
  \textcolor{azulpetroleo}{\inserttocsection}\par}
\setbeamertemplate{subsection in toc}{}

% título do slide: texto azul-petróleo + filete âmbar curto
\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,ht=2.8ex,dp=1.1ex,leftskip=0.6cm,rightskip=0.4cm plus1fil]{}%
    \codclarotrue\color{azulpetroleo}\usebeamerfont{frametitle}\insertframetitle%
    \ifx\insertframesubtitle\@empty\else%
      \hspace{0.6em}{\normalfont\footnotesize\color{cinzatexto}\insertframesubtitle}%
    \fi%
  \end{beamercolorbox}%
  \hspace*{0.6cm}\textcolor{ambar}{\rule{2.2cm}{2.2pt}}\vspace{0.1em}
}

% rodapé: título curto à esquerda, número do slide em âmbar à direita
\setbeamertemplate{footline}{%
  \hbox{%
    \begin{beamercolorbox}[wd=0.5\paperwidth,ht=2.2ex,dp=1.0ex,leftskip=0.6cm]{}%
      \tiny\color{azulpetroleo}\insertshorttitle%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=0.5\paperwidth,ht=2.2ex,dp=1.0ex,rightskip=0.6cm]{}%
      \hfill\tiny\color{ambar}\textbf{\insertframenumber}%
    \end{beamercolorbox}%
  }%
}

% ------------------------------------------------------------------- capa ----
\newcommand{\capa}{%
\begin{frame}[plain,noframenumbering]
  \begin{tikzpicture}[remember picture,overlay]
    \fill[azulpetroleo] (current page.north west) rectangle (current page.south east);
    \fill[ambar] (current page.north west) rectangle ([xshift=0.22cm]current page.south west);
    \node[anchor=south west,font=\footnotesize\bfseries,text=ambarclaro]
      at ([xshift=1.45cm,yshift=2.75cm]current page.west)
      {\MakeUppercase{\nomecurso}\quad$\cdot$\quad MÓDULO \nummodulo\quad$\cdot$\quad \rotulotrilha\quad$\cdot$\quad NÍVEL \MakeUppercase{\nivelmodulo}};
    \node[anchor=north west,text width=0.78\paperwidth,align=left]
      at ([xshift=1.4cm,yshift=2.6cm]current page.west)
      {\color{white}\LARGE\bfseries\inserttitle};
    \draw[ambar,line width=3pt] ([xshift=1.45cm,yshift=0.55cm]current page.west) -- ++(3.5,0);
    \node[anchor=north west,text width=0.78\paperwidth]
      at ([xshift=1.45cm,yshift=0.10cm]current page.west)
      {\color{ambarclaro}\normalsize\insertsubtitle};
    \node[anchor=north west,text width=0.78\paperwidth]
      at ([xshift=1.45cm,yshift=-1.05cm]current page.west)
      {\color{white}\large\bfseries\insertauthor};
    \node[anchor=south west] at ([xshift=1.45cm,yshift=1.0cm]current page.south west)
      {\color{white!70}\footnotesize\insertdate};
  \end{tikzpicture}
\end{frame}}

% ------------------------------------------------------- página de seção ----
\AtBeginSection[]{%
\begin{frame}[plain,noframenumbering]
  \begin{tikzpicture}[remember picture,overlay]
    \fill[azulpetroleo] (current page.north west) rectangle (current page.south east);
    \node[anchor=south west,text width=0.85\paperwidth,inner sep=0pt] (titulosecao) at ([xshift=1.2cm,yshift=-0.2cm]current page.west)
      {\color{white}\Huge\bfseries\raggedright\hyphenpenalty=10000\exhyphenpenalty=10000 \insertsectionhead\par};
    \draw[ambar,line width=2.5pt] ([yshift=-0.55cm]titulosecao.south west) -- ++(3.2,0);
  \end{tikzpicture}
\end{frame}}

% -------------------------------------------------------- roteiro e fim ----
\newcommand{\sumario}{%
  \begin{frame}{Roteiro}
    \vspace{0.3em}
    \begin{caixatitulo}{Neste módulo}
      \begin{multicols}{2}\small\tableofcontents\end{multicols}
    \end{caixatitulo}
  \end{frame}}

\newcommand{\encerramento}[1]{%
  \begin{frame}[plain,noframenumbering]
    \begin{tikzpicture}[remember picture,overlay]
      \fill[azulpetroleo] (current page.north west) rectangle (current page.south east);
      \draw[ambar,line width=3pt] ([xshift=1.2cm,yshift=1.6cm]current page.west) -- ++(3.5,0);
      \node[anchor=west,text width=0.8\paperwidth] at ([xshift=1.2cm,yshift=0.6cm]current page.west)
        {\color{white}\Huge\bfseries Fim do Módulo \nummodulo};
      \node[anchor=north west,text width=0.72\paperwidth] at ([xshift=1.25cm,yshift=-0.4cm]current page.west)
        {\color{ambarclaro}\normalsize\textbf{Próximo:} #1};
    \end{tikzpicture}
  \end{frame}}

% \codclarotrue: \cod herda a cor do texto (títulos, caixas escuras)
\newif\ifcodclaro

% ---------------------------------------------------------------- caixas ----
% As três caixas do modelo da casa
\newtcolorbox{caixadestaque}[1][]{%
  enhanced, colback=cinzafundo, colframe=azulpetroleo,
  boxrule=0pt, leftrule=3pt, arc=1pt, left=6pt, right=6pt, top=5pt, bottom=5pt,
  before skip=4pt, after skip=4pt, fontupper=\small, #1}
\newtcolorbox{caixaambar}[1][]{%
  enhanced, colback=ambarclaro!35, colframe=ambar,
  boxrule=0pt, leftrule=3pt, arc=1pt, left=6pt, right=6pt, top=5pt, bottom=5pt,
  before skip=4pt, after skip=4pt, fontupper=\small, #1}
\newtcolorbox{caixatitulo}[2][]{%
  enhanced, colback=white, colframe=azulpetroleo, boxrule=0.8pt, arc=2pt,
  fonttitle=\small\bfseries\codclarotrue, colbacktitle=azulpetroleo, coltitle=white, halign title=flush left,
  toptitle=0.5pt, bottomtitle=0.5pt, title={#2}, fontupper=\footnotesize,
  left=5pt, right=5pt, top=3pt, bottom=3pt, before skip=3pt, after skip=3pt, #1}

% Caixas semânticas do curso, construídas sobre as três acima
\tcbset{
  casatitulo/.style={enhanced, colback=white, boxrule=0.8pt, arc=2pt,
    fonttitle=\small\bfseries\codclarotrue, coltitle=white, halign title=flush left, toptitle=0.5pt, bottomtitle=0.5pt,
    fontupper=\footnotesize, halign=left, left=5pt, right=5pt, top=3pt, bottom=3pt,
    before skip=3pt, after skip=3pt},
  casafaixa/.style={enhanced, boxrule=0pt, leftrule=3pt, arc=1pt,
    left=6pt, right=6pt, top=3pt, bottom=3pt, fontupper=\small, halign=left,
    before skip=3pt, after skip=3pt},
}
% com faixa de título (caixatitulo)
\newtcolorbox{conceito}[1][Conceito]{casatitulo, colframe=azulpetroleo, colbacktitle=azulpetroleo, title={#1}}
\newtcolorbox{resumo}[1][Resumo]{casatitulo, colframe=azulpetroleo, colbacktitle=azulpetroleo, title={#1}}
\newtcolorbox{exemplo}[1][Exemplo]{casatitulo, colframe=azulprofundo, colbacktitle=azulprofundo, title={#1}}
\newtcolorbox{exercicio}[1][Exercício]{casatitulo, colframe=ambar, colbacktitle=ambar,
  coltitle=azulpetroleo, title={#1}}
% com faixa lateral (caixadestaque / caixaambar) e título na primeira linha
\newtcolorbox{dica}[1][Dica]{casafaixa, colback=cinzafundo, colframe=azulpetroleo,
  before upper={{\bfseries\color{azulpetroleo}#1}\par\vspace{2pt}}}
\newtcolorbox{atencao}[1][Atenção]{casafaixa, colback=ambarclaro!35, colframe=ambar,
  before upper={{\bfseries\color{ambar!70!black}#1}\par\vspace{2pt}}}
\newtcolorbox{projeto}[1][Projeto LabMonitor]{casafaixa, colback=ambarclaro!35, colframe=azulpetroleo,
  before upper={{\bfseries\color{azulpetroleo}#1}\par\vspace{2pt}}}
\newtcolorbox{erro}[1][Erro comum]{casafaixa, colback=vermelhoerro!6, colframe=vermelhoerro,
  before upper={{\bfseries\color{vermelhoerro}#1}\par\vspace{2pt}}}
% ------------------------------------------------- caixas didáticas ----
% definição formal de um termo
\newtcolorbox{definicao}[1][Definição]{casatitulo, colframe=azulprofundo, colbacktitle=azulprofundo, title={#1}}
% como a tecnologia funciona por baixo dos panos
\newtcolorbox{pordentro}[1][Por dentro]{casatitulo, colframe=cinzamedio, colbacktitle=cinzamedio, title={#1}}
% analogia com o dia a dia
\newtcolorbox{analogia}[1][Analogia]{casafaixa, colback=verdeok!7, colframe=verdeok,
  before upper={{\bfseries\color{verdeok}#1}\par\vspace{2pt}}}
% contexto histórico
\newtcolorbox{historia}[1][Um pouco de história]{casafaixa, colback=cinzaclaro!55, colframe=cinzamedio,
  before upper={{\bfseries\color{cinzatexto}#1}\par\vspace{2pt}}}

% glossário do módulo:  \begin{glossario} Termo & significado \\ ... \end{glossario}
% (argumento opcional: largura da coluna de termos)
\newenvironment{glossario}[1][3.1cm]{%
  \footnotesize\renewcommand{\arraystretch}{1.2}%
  \tabularx{\textwidth}{@{}>{\leavevmode\bfseries\color{azulpetroleo}\raggedright\arraybackslash}p{#1} L@{}}%
  \toprule \cabecalho{Termo} & \cabecalho{Significado} \\ \midrule}%
  {\bottomrule\endtabularx}

% questões de revisão e respostas comentadas
\newenvironment{questoes}{\begin{enumerate}\small\setlength{\itemsep}{4pt}}{\end{enumerate}}
\newenvironment{respostas}{\begin{enumerate}\scriptsize\setlength{\itemsep}{3pt}}{\end{enumerate}}

% frase de efeito centralizada (estilo caixaambar)
\newtcolorbox{destaque}[1][]{casafaixa, colback=ambarclaro!35, colframe=ambar, halign=center,
  top=5pt, bottom=5pt, #1}

