% =============================================================================
%  devmobile.sty — Estilo compartilhado dos slides do curso DevMobile
%  Paleta: azul-petróleo (#0D3052 / #0E3B43) e âmbar (#DE8A1C / #E69A1F)
%  Uso (no preâmbulo de cada módulo, após \documentclass{beamer}):
%      \makeatletter\def\input@path{{../estilo/}{estilo/}}\makeatother
%      \usepackage{devmobile}
%      \modulo{03}{Título do módulo}{Subtítulo}
% =============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{devmobile}[2026/11/01 Estilo dos slides DevMobile]

% ---------------------------------------------------------------- pacotes ----
\RequirePackage[shorthands=off,brazilian]{babel}
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage[scaled=0.92]{helvet}
\renewcommand{\familydefault}{\sfdefault}
\RequirePackage{textcomp}
\RequirePackage{microtype}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{multicol}
\RequirePackage{ifthen}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,shapes.geometric,shapes.misc,calc,fit,backgrounds,shadows,decorations.pathmorphing,decorations.pathreplacing}
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{listings}
\RequirePackage{listings}

% ------------------------------------------------------------------ cores ----
\definecolor{petroleo}{HTML}{0D3052}
\definecolor{petroleoesc}{HTML}{0E3B43}
\definecolor{ambar}{HTML}{DE8A1C}
\definecolor{ambarclaro}{HTML}{E69A1F}
\definecolor{cinzatexto}{HTML}{2F3A45}
\definecolor{cinzamedio}{HTML}{6B7785}
\definecolor{cinzaclaro}{HTML}{E3E8ED}
\definecolor{codefundo}{HTML}{F4F6F9}
\definecolor{verdeok}{HTML}{2E7D5B}
\definecolor{vermelhoerro}{HTML}{B03A2E}

% ------------------------------------------------------- metadados do curso --
\newcommand{\nomecurso}{Desenvolvimento de Aplicativos Mobile}
\newcommand{\autorcurso}{Prof. Dr. Francisco}            % edite aqui
\newcommand{\instituicaocurso}{IFMA -- Campus São Luís -- Monte Castelo}
\newcommand{\departamentocurso}{Departamento de Eletroeletrônica (DEE)}
\newcommand{\nummodulo}{00}

% \modulo{número}{título}{subtítulo}
\newcommand{\modulo}[3]{%
  \renewcommand{\nummodulo}{#1}%
  \title[Módulo #1 · #2]{#2}%
  \subtitle{#3}%
  \author{\autorcurso}%
  \institute{\instituicaocurso\\\departamentocurso}%
  \date{\today}%
}

% ------------------------------------------------------------ beamer base ----
\setbeamertemplate{navigation symbols}{}
\setbeamersize{text margin left=7mm,text margin right=7mm}
\setbeamercolor{normal text}{fg=cinzatexto}
\setbeamercolor{structure}{fg=petroleo}
\setbeamercolor{alerted text}{fg=ambar}
\setbeamercolor{example text}{fg=verdeok}
\setbeamercolor{frametitle}{fg=white,bg=petroleo}
\setbeamercolor{framesubtitle}{fg=ambarclaro}
\setbeamercolor{linhaambar}{bg=ambar}
\setbeamercolor{rodape esq}{fg=white,bg=petroleoesc}
\setbeamercolor{rodape dir}{fg=white,bg=petroleo}
\setbeamercolor{item projected}{fg=white,bg=petroleo}
\setbeamerfont{frametitle}{size=\large,series=\bfseries}
\setbeamerfont{framesubtitle}{size=\footnotesize,series=\mdseries}
\setbeamerfont{footline}{size=\tiny}
\setbeamerfont{block title}{size=\small,series=\bfseries}

% marcadores de lista
\setbeamertemplate{itemize item}{\textcolor{ambar}{\small$\blacktriangleright$}}
\setbeamertemplate{itemize subitem}{\textcolor{petroleo}{\scriptsize$\bullet$}}
\setbeamertemplate{itemize subsubitem}{\textcolor{cinzamedio}{\tiny$\circ$}}
\setbeamertemplate{enumerate item}{\textcolor{petroleo}{\bfseries\insertenumlabel.}}
\setbeamertemplate{enumerate subitem}{\textcolor{ambar}{\insertsubenumlabel)}}

% sumário
\setbeamertemplate{section in toc}{%
  \leavevmode\textcolor{ambar}{\bfseries\inserttocsectionnumber}\enspace
  \textcolor{petroleo}{\inserttocsection}\par}
\setbeamertemplate{subsection in toc}{}

% título do slide: faixa azul-petróleo + filete âmbar
\setbeamertemplate{frametitle}{%
  \nointerlineskip%
  \begin{beamercolorbox}[wd=\paperwidth,ht=3.1ex,dp=1.3ex,leftskip=7mm,rightskip=7mm plus1fil]{frametitle}%
    \def\cod##1{{\ttfamily\color{ambarclaro}##1}}%
    \usebeamerfont{frametitle}\insertframetitle%
    \ifx\insertframesubtitle\@empty\else%
      \hspace{0.6em}{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle}%
    \fi%
  \end{beamercolorbox}%
  \nointerlineskip%
  \begin{beamercolorbox}[wd=\paperwidth,ht=1.6pt,dp=0pt]{linhaambar}\end{beamercolorbox}%
  \vskip2pt%
}

% rodapé: barra de progresso + identificação + número do slide
\setbeamertemplate{footline}{%
  \leavevmode%
  \begin{tikzpicture}[x=1pt,y=1pt]
    \fill[cinzaclaro] (0,0) rectangle (\the\paperwidth,1.4);
    \pgfmathsetmacro{\progresso}{min(1,\insertframenumber/max(1,\inserttotalframenumber))}
    \fill[ambar] (0,0) rectangle ({\progresso*\the\paperwidth},1.4);
  \end{tikzpicture}\par\nointerlineskip%
  \hbox{%
  \begin{beamercolorbox}[wd=.78\paperwidth,ht=2.3ex,dp=0.9ex,leftskip=7mm]{rodape esq}%
    \usebeamerfont{footline}\textbf{DevMobile}\enspace\textcolor{ambarclaro}{|}\enspace\insertshorttitle%
  \end{beamercolorbox}%
  \begin{beamercolorbox}[wd=.22\paperwidth,ht=2.3ex,dp=0.9ex,rightskip=7mm,right]{rodape dir}%
    \usebeamerfont{footline}\insertframenumber\,/\,\inserttotalframenumber%
  \end{beamercolorbox}}%
}

% ----------------------------------------------------------- celular TikZ ----
% \celular[escala]{conteúdo da tela} — ícone de smartphone decorativo
\newcommand{\celular}[2][1]{%
  \begin{tikzpicture}[scale=#1,every node/.style={transform shape}]
    \draw[line width=1.6pt,rounded corners=6pt,fill=petroleoesc] (0,0) rectangle (2.2,4.2);
    \fill[white!96!petroleo,rounded corners=2pt] (0.15,0.45) rectangle (2.05,3.85);
    \fill[ambar] (0.85,4.0) rectangle (1.35,4.06);
    \draw[line width=0.8pt,ambar] (1.1,0.22) circle (0.1);
    \node[align=center,text width=1.7cm,font=\tiny] at (1.1,2.15) {#2};
  \end{tikzpicture}}

% ------------------------------------------------------------------ capa ----
\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[petroleo] (current page.south west) rectangle (current page.north east);
    \fill[petroleoesc] (current page.south west) rectangle ([yshift=1.25cm]current page.south east);
    \fill[ambar] ([yshift=1.25cm]current page.south west) rectangle ([yshift=1.33cm]current page.south east);
    % padrão decorativo de pontos
    \foreach \i in {0,...,9}{\foreach \j in {0,...,5}{
      \fill[white,opacity=0.07] ([xshift=-0.4cm-\i*0.42cm,yshift=-0.5cm-\j*0.42cm]current page.north east) circle (1.3pt);}}
    % smartphone estilizado
    \begin{scope}[shift={([xshift=-4.0cm,yshift=-2.55cm]current page.east)},scale=1.15]
      \draw[white,line width=1.8pt,rounded corners=7pt] (0,0) rectangle (2.3,4.4);
      \fill[white,opacity=0.10,rounded corners=3pt] (0.16,0.5) rectangle (2.14,4.0);
      \fill[ambar] (0.9,4.16) rectangle (1.4,4.23);
      \draw[ambar,line width=1pt] (1.15,0.25) circle (0.11);
      \foreach \y in {3.55,3.15,2.75}{\fill[white,opacity=0.55,rounded corners=1pt] (0.35,\y) rectangle (1.95,\y+0.22);}
      \fill[ambar,rounded corners=2pt] (0.35,1.0) rectangle (1.95,1.45);
      \fill[white,opacity=0.35,rounded corners=1pt] (0.35,1.7) rectangle (1.15,2.45);
      \fill[white,opacity=0.35,rounded corners=1pt] (1.25,1.7) rectangle (1.95,2.45);
    \end{scope}
    \node[anchor=north west,font=\footnotesize\bfseries,text=ambarclaro]
      at ([xshift=7mm,yshift=-9mm]current page.north west) {\MakeUppercase{\nomecurso}};
    \node[anchor=south west,font=\Large\bfseries,text=ambar]
      at ([xshift=7mm,yshift=0.95cm]current page.west) {MÓDULO \nummodulo};
    \node[anchor=north west,text width=8.6cm,font=\LARGE\bfseries,text=white,align=left]
      (titulo) at ([xshift=7mm,yshift=0.85cm]current page.west) {\inserttitle};
    \node[anchor=north west,text width=8.6cm,font=\small,text=white!80!ambar,align=left]
      at ([yshift=-1mm]titulo.south west) {\insertsubtitle};
    \node[anchor=south west,font=\scriptsize,text=white,align=left]
      at ([xshift=7mm,yshift=2.5mm]current page.south west) {\textbf{\insertauthor}\\\insertinstitute};
    \node[anchor=south east,font=\scriptsize,text=white!70]
      at ([xshift=-7mm,yshift=3mm]current page.south east) {\insertdate};
  \end{tikzpicture}%
}
\newcommand{\capa}{\begin{frame}[plain,noframenumbering]\titlepage\end{frame}}

% ------------------------------------------------------- divisor de seção ----
\AtBeginSection[]{%
  \begin{frame}[plain,noframenumbering]
    \begin{tikzpicture}[remember picture,overlay]
      \fill[petroleoesc] (current page.south west) rectangle (current page.north east);
      \fill[ambar] ([xshift=7mm,yshift=-0.2cm]current page.west) rectangle ([xshift=9mm,yshift=1.9cm]current page.west);
      \node[anchor=south west,font=\fontsize{40}{40}\selectfont\bfseries,text=ambar]
        at ([xshift=12mm,yshift=0.55cm]current page.west) {\insertsectionnumber};
      \node[anchor=north west,text width=11cm,font=\LARGE\bfseries,text=white,align=left]
        at ([xshift=12mm,yshift=0.45cm]current page.west) {\insertsectionhead};
      \node[anchor=south west,font=\scriptsize,text=white!65]
        at ([xshift=7mm,yshift=4mm]current page.south west) {DevMobile \textbullet\ Módulo \nummodulo\ \textbullet\ \inserttitle};
    \end{tikzpicture}
  \end{frame}
}

% sumário do módulo
\newcommand{\sumario}{%
  \begin{frame}{Roteiro do módulo}
    \begin{multicols}{2}\tableofcontents\end{multicols}
  \end{frame}}

% slide de encerramento
\newcommand{\encerramento}[1]{%
  \begin{frame}[plain,noframenumbering]
    \begin{tikzpicture}[remember picture,overlay]
      \fill[petroleo] (current page.south west) rectangle (current page.north east);
      \fill[ambar] ([yshift=-0.9cm]current page.west) rectangle ([yshift=-0.82cm]current page.east);
      \node[font=\Huge\bfseries,text=white] at ([yshift=0.6cm]current page.center) {Fim do Módulo \nummodulo};
      \node[font=\small,text=white!80,text width=11cm,align=center] at ([yshift=-1.7cm]current page.center)
        {\textcolor{ambarclaro}{\textbf{Próximo:}} #1};
    \end{tikzpicture}
  \end{frame}}

% ------------------------------------------------------- caixas tcolorbox ----
\tcbset{
  dmbase/.style={enhanced,arc=2pt,boxrule=0.6pt,left=5pt,right=5pt,top=3pt,bottom=3pt,
    fonttitle=\bfseries\scriptsize\codclarotrue,fontupper=\small,coltitle=white,halign=left,
    before skip=4pt,after skip=4pt,attach boxed title to top left={xshift=6pt,yshift=-2mm},
    boxed title style={arc=1pt,boxrule=0pt,top=1pt,bottom=1pt}},
}
\newtcolorbox{conceito}[1][Conceito]{dmbase,colback=petroleo!5,colframe=petroleo,
  boxed title style={colback=petroleo},title={#1},top=6pt}
\newtcolorbox{dica}[1][Dica]{dmbase,colback=petroleoesc!6,colframe=petroleoesc,
  boxed title style={colback=petroleoesc},title={#1},top=6pt}
\newtcolorbox{atencao}[1][Atenção]{dmbase,colback=ambar!9,colframe=ambar,
  boxed title style={colback=ambar},title={#1},top=6pt}
\newtcolorbox{exemplo}[1][Exemplo]{dmbase,colback=verdeok!6,colframe=verdeok,
  boxed title style={colback=verdeok},title={#1},top=6pt}
\newtcolorbox{erro}[1][Erro comum]{dmbase,colback=vermelhoerro!6,colframe=vermelhoerro,
  boxed title style={colback=vermelhoerro},title={#1},top=6pt}
\newtcolorbox{exercicio}[1][Exercício]{dmbase,colback=white,colframe=ambar,
  boxed title style={colback=petroleo},title={#1},top=6pt,borderline west={3pt}{0pt}{ambar}}
\newtcolorbox{projeto}[1][Projeto LabMonitor]{dmbase,colback=ambar!5,colframe=petroleo,
  boxed title style={colback=ambar},title={#1},top=6pt,borderline west={3pt}{0pt}{petroleo}}
\newtcolorbox{resumo}[1][Resumo]{dmbase,colback=petroleo!4,colframe=petroleo!60,
  boxed title style={colback=petroleo!80},title={#1},top=6pt}
% caixa simples sem título (para destacar uma ideia)
\newtcolorbox{destaque}[1][]{enhanced,arc=2pt,boxrule=0pt,colback=petroleo,colupper=white,
  left=6pt,right=6pt,top=4pt,bottom=4pt,fontupper=\small,halign=center,#1}

