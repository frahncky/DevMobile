% =============================================================================
%  devmobile.sty --- Estilo dos slides do curso DevMobile
%  Baseado no modelo Beamer da casa (paleta azul-petróleo + âmbar):
%    * título do slide em azul-petróleo sobre fundo branco, com filete âmbar;
%    * rodapé limpo (título curto à esquerda, número em âmbar à direita);
%    * marcadores quadrados em âmbar;
%    * capa, páginas de seção e encerramento em azul-petróleo sólido;
%    * caixas caixadestaque, caixaambar e caixatitulo.
%  Uso (no preâmbulo de cada módulo, após \documentclass{beamer}):
%      \makeatletter\def\input@path{{../../estilo/}{../estilo/}{estilo/}}\makeatother
%      \usepackage{devmobile}
%      \modulo[Flutter]{05}{Título do módulo}{Subtítulo}   (sem [..] = módulo comum)
% =============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{devmobile}[2026/11/01 Estilo dos slides DevMobile (modelo da casa)]

% ---------------------------------------------------------------- pacotes ----
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\IfFileExists{portuges.ldf}{\RequirePackage[shorthands=off,brazil]{babel}}{}
\IfFileExists{lmodern.sty}{%
  \RequirePackage{lmodern}%
  \IfFileExists{microtype.sty}{\RequirePackage{microtype}}{}%
}{}
\RequirePackage{textcomp}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{multicol}
\RequirePackage{ifthen}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,shapes.geometric,shapes.misc,shapes.multipart,calc,fit,backgrounds,
  shadows,decorations.pathmorphing,decorations.pathreplacing}
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{listings}
\RequirePackage{listings}

% ------------------------------------------------------- paleta da casa ----
\definecolor{azulpetroleo}{HTML}{0D3052}
\definecolor{azulprofundo}{HTML}{0E3B43}
\definecolor{ambar}{HTML}{F2A104}
\definecolor{ambarclaro}{HTML}{FFD8A0}
\definecolor{cinzafundo}{HTML}{F3F5F7}
\definecolor{cinzatexto}{HTML}{3C4A55}
% nomes usados nos módulos (apelidos da paleta)
\colorlet{petroleo}{azulpetroleo}
\colorlet{petroleoesc}{azulprofundo}
\definecolor{cinzamedio}{HTML}{6B7785}
\definecolor{cinzaclaro}{HTML}{E3E8ED}
\colorlet{codefundo}{cinzafundo}
